{
  "scope": "isolated MiniMax build; execution results are recorded separately",
  "runtime_enabled": "@STRATA_MM27_RUNTIME@",
  "runtime_generated_sha256": "@mm27_runtime_hashes@",
  "source_revision": "@STRATA_MM27_SOURCE_SHA@",
  "archive_sha256": "@STRATA_MM27_ARCHIVE_SHA256@",
  "loader_sha256": "@STRATA_MM27_LOADER_SHA256@",
  "patches": "@mm27_patch_set@",
  "oracle_source_sha256": {
    "loader": "@mm27_loader_sha256@",
    "tokenizer": "@mm27_tokenizer_sha256@",
    "template": "@mm27_template_sha256@"
  },
  "compiler": "@CMAKE_CXX_COMPILER_ID@",
  "compiler_version": "@CMAKE_CXX_COMPILER_VERSION@",
  "generator": "@CMAKE_GENERATOR@",
  "build_type": "@CMAKE_BUILD_TYPE@",
  "cxx_flags": "@CMAKE_CXX_FLAGS@",
  "release_flags": "@CMAKE_CXX_FLAGS_RELEASE@",
  "cuda": @mm27_cuda_json@,
  "cuda_compiler_version": "@CMAKE_CUDA_COMPILER_VERSION@",
  "cuda_architectures": "@CMAKE_CUDA_ARCHITECTURES@",
  "cuda_backend_architectures": "@mm27_cuda_target_architectures@",
  "cuda_mmf_generated_sha256": "@mm27_mmf_generated_sha256@",
  "cuda_dispatch_generated_sha256": "@mm27_dispatch_generated_sha256@",
  "cuda_quant_dispatch_generated_sha256": "@mm27_quant_dispatch_sha256@",
  "numerical_source_sha256": {
    "kernels": "@mm27_kernels_sha256@",
    "graph": "@mm27_graph_sha256@",
    "fixture": "@mm27_fixture_sha256@"
  },
  "shared_libraries": false,
  "dynamic_backends": false
}
