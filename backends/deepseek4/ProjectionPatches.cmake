# Research only: trace the actual projection dispatch, and optionally compare
# Q8_0 attention/shared MMQ and sample-axis HC/router MMVF. Keep the dependency intact.
include(ProjectionMmqPatches.cmake)
# The sample-axis adapter depends on the pinned MMVF's broadcast and strides.
file(SHA256 "${STRATA_LLAMA_DIR}/ggml/src/ggml-cuda/mmvf.cu" ds4_hc_mmvf_hash)
if(NOT ds4_hc_mmvf_hash STREQUAL "0aca92c9d54cf4a17cf79ee082f243b99c9bf62915e523050ab57c55e30555a1")
  message(FATAL_ERROR "Review DeepSeek HC/router sample-axis adapter for changed MMVF source")
endif()
file(SHA256 "${STRATA_LLAMA_DIR}/ggml/src/ggml-cuda/ggml-cuda.cu" ds4_projection_hash)
if(NOT ds4_projection_hash STREQUAL "af947e45946d0c47cfae9e056f589a25b61892e4273decf0a893e2dcad48d065")
  message(FATAL_ERROR "Review DeepSeek projection dispatch for changed CUDA source")
endif()
set(ds4_projection_begin "static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {")
set(ds4_projection_end "// returns true when ggml_cuda_mul_mat_id takes the fallback path")
string(FIND "${cuda_source}" "${ds4_projection_begin}" ds4_projection_start)
string(FIND "${cuda_source}" "${ds4_projection_end}" ds4_projection_stop)
if(ds4_projection_start LESS 0 OR ds4_projection_stop LESS ds4_projection_start)
  message(FATAL_ERROR "Missing DeepSeek projection dispatch boundary")
endif()
math(EXPR ds4_projection_length "${ds4_projection_stop} - ${ds4_projection_start}")
string(SUBSTRING "${cuda_source}" ${ds4_projection_start} ${ds4_projection_length} ds4_projection_body)
set(ds4_projection_old "${ds4_projection_body}")
foreach(pair "cublas|cublas" "vec_f|mmvf" "f|mmf" "vec_q|mmvq" "q|mmq")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 func)
  list(GET parts 1 label)
  if(func STREQUAL "cublas")
    set(call "ggml_cuda_mul_mat_${func}(ctx, src0, src1, dst);")
  else()
    set(call "ggml_cuda_mul_mat_${func}(ctx, src0, src1, nullptr, dst);")
  endif()
  string(REPLACE "${call}" "strata_projection_trace(src0, src1, dst, \"${label}\");\n        ${call}" ds4_projection_body "${ds4_projection_body}")
endforeach()
set(ds4_projection_anchor "    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;")
string(REPLACE "${ds4_projection_anchor}" "${ds4_projection_anchor}\n#include \"projection_dispatch.inc\"" ds4_projection_body "${ds4_projection_body}")
string(REPLACE "${ds4_projection_old}" "#include \"projection_trace.hpp\"\n${ds4_projection_body}" cuda_source "${cuda_source}")

# A single-token fused gate/up/GLU bypasses ggml_cuda_mul_mat. Decline only
# eligible shared projections, including the scale/bias MMVQ shortcuts.
set(ds4_shared_anchor "static bool ggml_cuda_should_fuse_mul_mat(const ggml_tensor * ffn_up,")
set(ds4_shared_body "    const bool has_bias = ffn_up_bias != nullptr || ffn_gate_bias != nullptr;")
set(ds4_shared_vec "static bool ggml_cuda_should_fuse_mul_mat_vec_q(const ggml_tensor * tensor) {")
foreach(anchor "${ds4_shared_anchor}" "${ds4_shared_body}" "${ds4_shared_vec}")
  string(FIND "${cuda_source}" "${anchor}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Missing shared expert fusion boundary")
  endif()
endforeach()
string(REPLACE "${ds4_shared_anchor}" "#include \"shared_projection.hpp\"\n${ds4_shared_anchor}" cuda_source "${cuda_source}")
string(REPLACE "${ds4_shared_body}" "    if (strata_shared_mmq_tensor(ffn_up) || strata_shared_mmq_tensor(ffn_gate)) return false;\n${ds4_shared_body}" cuda_source "${cuda_source}")
string(REPLACE "${ds4_shared_vec}" "${ds4_shared_vec}\n    if (strata_shared_mmq_tensor(tensor)) return false;" cuda_source "${cuda_source}")

# Use the same predicate for short MUL_MAT_ID dispatch and fused shortcuts.
string(REPLACE "#include \"shared_projection.hpp\"" "#include \"shared_projection.hpp\"\n#include \"routed_mmq.hpp\"" cuda_source "${cuda_source}")
string(REPLACE "${ds4_shared_body}" "    if (strata_routed_mmq_tensor(ffn_up) || strata_routed_mmq_tensor(ffn_gate)) return false;\n${ds4_shared_body}" cuda_source "${cuda_source}")
string(REPLACE "${ds4_shared_vec}" "${ds4_shared_vec}\n    if (strata_routed_mmq_tensor(tensor)) return false;" cuda_source "${cuda_source}")
set(ds4_routed_anchor "static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {")
string(FIND "${cuda_source}" "${ds4_routed_anchor}" found)
if(found LESS 0)
  message(FATAL_ERROR "Missing routed MMQ dispatch boundary")
endif()
string(REPLACE "${ds4_routed_anchor}" "${ds4_routed_anchor}\n    if (strata_routed_mmq_tensor(dst)) {\n        ggml_cuda_mul_mat_q(ctx,dst->src[0],dst->src[1],dst->src[2],dst);\n        return;\n    }" cuda_source "${cuda_source}")
