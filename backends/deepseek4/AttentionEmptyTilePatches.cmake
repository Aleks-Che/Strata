# Opt-in variant of the private attention kernel; upstream kernels unchanged.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/attention_empty_tile.inc")
file(READ "${CMAKE_CURRENT_LIST_DIR}/attention_empty_tile.inc" empty_tile)
set(empty_template "bool use_sparse, bool needs_fixup, bool is_fixup>\nstatic __device__ __forceinline__ void flash_attn_ext_f16_process_tile(")
set(empty_kernel "bool V_is_K_view, bool use_sparse>\n__launch_bounds__")
set(empty_call "use_sparse, needs_fixup, is_fixup>")
set(empty_insert "    if (cols_per_warp > ncols) {")
set(empty_dispatch "fattn_kernel = flash_attn_ext_f16<DKQ, DV, ncols1, ncols2, use_logit_softcap, V_is_K_view, use_sparse_kernel>;")
foreach(anchor "${empty_template}" "${empty_kernel}" "${empty_call}" "${empty_insert}" "${empty_dispatch}")
  string(FIND "${ds4_mma}" "${anchor}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Pinned attention empty tile anchor missing: ${anchor}")
  endif()
endforeach()
string(REPLACE "${empty_template}" "bool use_sparse, bool needs_fixup, bool is_fixup, bool strata_skip_empty>\nstatic __device__ __forceinline__ void flash_attn_ext_f16_process_tile(" ds4_mma "${ds4_mma}")
string(REPLACE "${empty_kernel}" "bool V_is_K_view, bool use_sparse, bool strata_skip_empty = false>\n__launch_bounds__" ds4_mma "${ds4_mma}")
string(REPLACE "${empty_call}" "use_sparse, needs_fixup, is_fixup, strata_skip_empty>" ds4_mma "${ds4_mma}")
string(REPLACE "${empty_insert}" "${empty_tile}\n${empty_insert}" ds4_mma "${ds4_mma}")
string(REPLACE "    fattn_kernel_t fattn_kernel;" "    const char *empty_mode = std::getenv(\"STRATA_DS4_FA_SKIP_EMPTY\");\n    const bool strata_skip_empty = empty_mode && std::strcmp(empty_mode, \"1\") == 0;\n    fattn_kernel_t fattn_kernel;" ds4_mma "${ds4_mma}")
string(REPLACE "${empty_dispatch}" "fattn_kernel = strata_skip_empty ? flash_attn_ext_f16<DKQ, DV, ncols1, ncols2, use_logit_softcap, V_is_K_view, use_sparse_kernel, true> : flash_attn_ext_f16<DKQ, DV, ncols1, ncols2, use_logit_softcap, V_is_K_view, use_sparse_kernel, false>;" ds4_mma "${ds4_mma}")
string(REPLACE "shared_memory_limit_raised[GGML_CUDA_MAX_DEVICES] = {false}" "shared_memory_limit_raised[2][GGML_CUDA_MAX_DEVICES] = {}" ds4_mma "${ds4_mma}")
string(REPLACE "shared_memory_limit_raised[id]" "shared_memory_limit_raised[strata_skip_empty][id]" ds4_mma "${ds4_mma}")
