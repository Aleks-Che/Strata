# Apply only to the private, hash-checked attention launch helper.
set(stage_prepare "        ggml_cuda_flash_attn_ext_compact_mask(")
set(stage_prepared "Q->ne[1], ncols1, n_kv_max, main_stream);")
set(stage_main "        ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(blocks_num, block_dim, nbytes_shared, main_stream);")
set(stage_main_done "    CUDA_CHECK(cudaGetLastError());\n\n    if (stream_k) {")
set(stage_done "    CUDA_CHECK(cudaGetLastError());\n}\n")
foreach(anchor "${stage_prepare}" "${stage_prepared}" "${stage_main}" "${stage_main_done}" "#include \"common.cuh\"")
  string(FIND "${ds4_common}" "${anchor}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Pinned attention stage anchor missing: ${anchor}")
  endif()
endforeach()
# This final check targets the end of the header, never other CUDA helpers.
string(LENGTH "${ds4_common}" stage_length)
string(LENGTH "${stage_done}" stage_tail_length)
math(EXPR stage_offset "${stage_length} - ${stage_tail_length}")
string(SUBSTRING "${ds4_common}" ${stage_offset} -1 stage_tail)
if(NOT stage_tail STREQUAL stage_done)
  message(FATAL_ERROR "Pinned attention stage final anchor missing")
endif()
string(SUBSTRING "${ds4_common}" 0 ${stage_offset} ds4_common)
string(APPEND ds4_common "    strata_attention_stage_profile().end(strata_fixup_event, main_stream);\n${stage_done}")
string(REPLACE "${stage_prepare}" "        const auto strata_prepare_event = strata_attention_stage_profile().begin(KQV, main_stream, \"prepare\", 0);\n${stage_prepare}" ds4_common "${ds4_common}")
string(REPLACE "${stage_prepared}" "${stage_prepared}\n        strata_attention_stage_profile().end(strata_prepare_event, main_stream);" ds4_common "${ds4_common}")
string(REPLACE "${stage_main}" "        const auto strata_main_event = strata_attention_stage_profile().begin(KQV, main_stream, \"mma\", blocks_num.x);\n${stage_main}" ds4_common "${ds4_common}")
string(REPLACE "${stage_main_done}" "    strata_attention_stage_profile().end(strata_main_event, main_stream);\n    const auto strata_fixup_event = strata_attention_stage_profile().begin(KQV, main_stream, \"fixup\", blocks_num.x);\n${stage_main_done}" ds4_common "${ds4_common}")
# ggml / CUDA types are declared by the upstream include before this helper.
string(REPLACE "#include \"common.cuh\"" "#include \"common.cuh\"\n#include \"attention_stage_profile.cuh\"" ds4_common "${ds4_common}")
