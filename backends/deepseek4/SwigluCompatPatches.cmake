# Private copies only; leave the pinned dependency and Qwen build untouched.
set(ds4_unary_original "${STRATA_LLAMA_DIR}/ggml/src/ggml-cuda/unary.cu")
file(SHA256 "${ds4_unary_original}" ds4_unary_hash)
if(NOT ds4_unary_hash STREQUAL "e8340525baecc6d34b6250fb4e588c774ddf22accc49b6526fa15691ae7def9a")
  message(FATAL_ERROR "Review DeepSeek SwiGLU patch for changed unary source")
endif()
file(READ "${ds4_unary_original}" ds4_unary)
string(REPLACE "#include \"unary.cuh\"" "#include \"unary.cuh\"\n#include \"swiglu_compat.cuh\"" ds4_unary "${ds4_unary}")
foreach(op swiglu swiglu_clamp)
  set(anchor "void ggml_cuda_op_${op}(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {")
  if(op STREQUAL "swiglu")
    set(limit "0.0f")
  else()
    set(limit "ggml_get_op_params_f32(dst, 3)")
  endif()
  string(REPLACE "${anchor}" "${anchor}\n    if (strata_swiglu_dispatch(ctx, dst, ${limit})) return;" ds4_unary "${ds4_unary}")
endforeach()

# The old fast-math quantizer also crosses half-integer boundaries. Reuse the
# pinned kernel, changing only its F32 normalization in the compatible variant.
set(ds4_quant_original "${STRATA_LLAMA_DIR}/ggml/src/ggml-cuda/quantize.cu")
file(SHA256 "${ds4_quant_original}" ds4_quant_hash)
if(NOT ds4_quant_hash STREQUAL "71cd7baab62ee1f457d23ae648c381d18b9b1327ec34832f31463b14b81895b3")
  message(FATAL_ERROR "Review DeepSeek compatible quantizer for changed source")
endif()
file(READ "${ds4_quant_original}" ds4_quant)
string(PREPEND ds4_quant "#include \"swiglu_compat.hpp\"\n")
string(REPLACE "__launch_bounds__(CUDA_QUANTIZE_BLOCK_SIZE, 1)\nstatic __global__ void quantize_q8_1("
  "template<bool strata_compatible>\n__launch_bounds__(CUDA_QUANTIZE_BLOCK_SIZE, 1)\nstatic __global__ void quantize_q8_1(" ds4_quant "${ds4_quant}")
string(REPLACE "    const float xi = i0 < ne00 ? x[i03*s03 + i02*s02 + i01*s01 + i00] : 0.0f;"
  "    float xi = i0 < ne00 ? x[i03*s03 + i02*s02 + i01*s01 + i00] : 0.0f;\n    if constexpr (strata_compatible) xi = strata_ds4::sw_flush(xi);" ds4_quant "${ds4_quant}")
string(REPLACE "    const float  d = amax / 127.0f;\n    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);"
  "    const float d = strata_compatible ? strata_ds4::sw_div(amax, 127.0f) : amax / 127.0f;\n    const int8_t q = (strata_compatible ? d == 0.0f : amax == 0.0f) ? 0 : roundf(strata_compatible ? strata_ds4::sw_div(xi, d) : xi / d);" ds4_quant "${ds4_quant}")
string(REPLACE "ggml_cuda_kernel_launch(quantize_q8_1," "ggml_cuda_kernel_launch(quantize_q8_1<false>," ds4_quant "${ds4_quant}")
string(FIND "${ds4_quant}" "void quantize_row_q8_1_cuda(" begin)
string(FIND "${ds4_quant}" "void quantize_mmq_q8_1_cuda(" end)
math(EXPR length "${end}-${begin}")
string(SUBSTRING "${ds4_quant}" ${begin} ${length} ds4_quant_wrapper)
string(REPLACE "quantize_row_q8_1_cuda" "strata_quantize_row_q8_1_compat_cuda" ds4_quant_wrapper "${ds4_quant_wrapper}")
string(REPLACE "quantize_q8_1<false>" "quantize_q8_1<true>" ds4_quant_wrapper "${ds4_quant_wrapper}")
string(APPEND ds4_quant "\n${ds4_quant_wrapper}")
set(ds4_quant_generated "${CMAKE_BINARY_DIR}/strata-ds4-quantize.cu")
set(ds4_quant_old "")
if(EXISTS "${ds4_quant_generated}")
  file(READ "${ds4_quant_generated}" ds4_quant_old)
endif()
if(NOT ds4_quant_old STREQUAL ds4_quant)
  file(WRITE "${ds4_quant_generated}" "${ds4_quant}")
endif()
get_target_property(ds4_cuda_sources ggml-cuda SOURCES)
set(ds4_quant_matches "${ds4_cuda_sources}")
list(FILTER ds4_quant_matches INCLUDE REGEX "(^|/)quantize\\.cu$")
list(LENGTH ds4_quant_matches ds4_quant_count)
if(NOT ds4_quant_count EQUAL 1)
  message(FATAL_ERROR "Expected one quantize.cu in ggml-cuda")
endif()
list(REMOVE_ITEM ds4_cuda_sources ${ds4_quant_matches})
set_property(TARGET ggml-cuda PROPERTY SOURCES "${ds4_cuda_sources};${ds4_quant_generated}")
set_source_files_properties("${ds4_quant_generated}" TARGET_DIRECTORY ggml-cuda PROPERTIES
  INCLUDE_DIRECTORIES "${STRATA_LLAMA_DIR}/ggml/src/ggml-cuda;${CMAKE_CURRENT_SOURCE_DIR}")
string(REPLACE "#include \"mmvq.cuh\"" "#include \"mmvq.cuh\"\n#include \"q8_1_compat.cuh\"" ds4_mmvq "${ds4_mmvq}")
set(quant_call "quantize_row_q8_1_cuda(src1_d, nullptr, src1_q8_1.get(), src0->type, ne10, s11, s12, s13, ne10_padded, ne11, ne12, ne13, stream);")
string(FIND "${ds4_mmvq}" "${quant_call}" found)
if(found EQUAL -1)
  message(FATAL_ERROR "Pinned MMVQ quantizer call not found")
endif()
string(REPLACE "${quant_call}" "(fusion_local.swiglu_compat ? strata_quantize_row_q8_1_compat_cuda : quantize_row_q8_1_cuda)(src1_d, nullptr, src1_q8_1.get(), src0->type, ne10, s11, s12, s13, ne10_padded, ne11, ne12, ne13, stream);" ds4_mmvq "${ds4_mmvq}")
set(ds4_unary_generated "${CMAKE_BINARY_DIR}/strata-ds4-unary.cu")
set(ds4_unary_old "")
if(EXISTS "${ds4_unary_generated}")
  file(READ "${ds4_unary_generated}" ds4_unary_old)
endif()
if(NOT ds4_unary_old STREQUAL ds4_unary)
  file(WRITE "${ds4_unary_generated}" "${ds4_unary}")
endif()
get_target_property(ds4_cuda_sources ggml-cuda SOURCES)
set(ds4_unary_matches "${ds4_cuda_sources}")
list(FILTER ds4_unary_matches INCLUDE REGEX "(^|/)unary\\.cu$")
list(LENGTH ds4_unary_matches ds4_unary_count)
if(NOT ds4_unary_count EQUAL 1)
  message(FATAL_ERROR "Expected one unary.cu in ggml-cuda")
endif()
list(REMOVE_ITEM ds4_cuda_sources ${ds4_unary_matches})
set_property(TARGET ggml-cuda PROPERTY SOURCES "${ds4_cuda_sources};${ds4_unary_generated}")
set_source_files_properties("${ds4_unary_generated}" TARGET_DIRECTORY ggml-cuda PROPERTIES
  INCLUDE_DIRECTORIES "${STRATA_LLAMA_DIR}/ggml/src/ggml-cuda;${CMAKE_CURRENT_SOURCE_DIR}")

# Both fused MMVQ kernels must obey the same contract as the separate GLU.
# Extend only the private argument structure (direct-cache builds already do).
string(REPLACE "#include \"mmvq.cuh\"" "#include \"mmvq.cuh\"\n#include \"swiglu_compat.hpp\"" ds4_mmvq "${ds4_mmvq}")
if(STRATA_DEEPSEEK_DIRECT_CACHE_EXPERIMENT)
  set(fusion_type "StrataDirectFusion")
else()
  set(fusion_type "StrataSwiGLUFusion")
  string(REPLACE "ggml_cuda_mm_fusion_args_device" "${fusion_type}" ds4_mmvq "${ds4_mmvq}")
  string(REPLACE "#include \"mmvq.cuh\""
    "#include \"mmvq.cuh\"\nstruct StrataSwiGLUFusion : ggml_cuda_mm_fusion_args_device { bool swiglu_compat=false; };"
    ds4_mmvq "${ds4_mmvq}")
endif()
set(anchor "${fusion_type} fusion_local{};\n\n    if (fusion)")
string(FIND "${ds4_mmvq}" "${anchor}" found)
if(found EQUAL -1)
  message(FATAL_ERROR "Pinned MMVQ fusion initialization not found")
endif()
string(REPLACE "${anchor}" "${fusion_type} fusion_local{};\n    fusion_local.swiglu_compat = ids && dst->ne[2] <= 4 && dst->ne[3] == 1 && strata_ds4::swiglu_compat_enabled();\n\n    if (fusion)" ds4_mmvq "${ds4_mmvq}")
foreach(clamped FALSE TRUE)
  if(clamped)
    set(old "result = ggml_cuda_op_swiglu_clamp_single(gate_value, result, glu_limit);")
    set(limit "glu_limit")
  else()
    set(old "result *= ggml_cuda_op_silu_single(gate_value);")
    set(limit "0.0f")
  endif()
  # Source identity is checked by ShortBatchPatches; use a literal replacement.
  string(FIND "${ds4_mmvq}" "${old}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Pinned MMVQ SwiGLU expression not found")
  endif()
  string(REPLACE "${old}" "if (fusion.swiglu_compat) result = strata_ds4::swiglu_compat(gate_value, result, ${limit}); else ${old}" ds4_mmvq "${ds4_mmvq}")
endforeach()
