  "benchmark_helpers": [
    {
      "file": {
        "path": "C:\\work\\git\\my-repos\\Strata\\build-local\\run-glm-final-mtp-sweep.py",
        "sha256": "2f695d89fc2d7c4b4eca2a1c7032c0b084f7735fef56972a2b23c0295adc2879"
      },
      "contents": "from pathlib import Path\nimport subprocess, sys\ncommon=[sys.executable,\"tools/benchmark_glm5next_mtp.py\",\"--reference\",\"docs/GLM53/GLM53_FLASH_SYNC_REPEAT.json\",\"--warmups\",\"4\",\"--repeats\",\"5\",\"--copy-events\",\"2\",\"--decode-readers\",\"1\",\"--write-combined\",\"0\",\"--pool-reclaim\",\"0\"]\nfor name,profile,depths,period,pool in [(\"glm-staging-cache-final-mtp\",\"build-local/glm-staging-cache-selected.json\",\"0,1,2,3\",131072,0),(\"glm-staging-cache-final-control\",\"strata-glm5next.json\",\"1\",4096,1)]:\n cmd=common+[\"--profile\",profile,\"--output\",\"build-local/\"+name+\".json\",\"--depths\",depths,\"--main-cache-decay\",str(period),\"--memory-pool\",str(pool)]\n print(\"START\",name,flush=True)\n with open(\"build-local/\"+name+\".log\",\"w\",encoding=\"utf-8\") as out:result=subprocess.run(cmd,stdout=out,stderr=subprocess.STDOUT)\n print(\"END\",name,result.returncode,flush=True)\n if result.returncode:sys.exit(result.returncode)\n"
    },
    {
      "file": {
        "path": "C:\\work\\git\\my-repos\\Strata\\build-local\\collect-glm-final-mtp.py",
        "sha256": "a19726e820a8038a57317db4e532c4d7bc6ebf19d68db231001838763b2e7e2e"
      },
      "contents": "from pathlib import Path\nimport hashlib, json, statistics\n\nroot = Path.cwd()\ndef read(path):\n    return json.loads((root / path).read_text(encoding='utf-8'))\ndef record(path):\n    p = root / path\n    return {'path': str(p), 'sha256': hashlib.sha256(p.read_bytes()).hexdigest()}\ndef summarize(v):\n    timed = [(i, r) for i, r in enumerate(v['runs']) if not r['warmup']]\n    speeds = [r['tokens_per_second'] for i, r in timed]\n    snapshots = [v['memory_snapshots'][i + 1] for i, r in timed]\n    assert len(timed) == 5 and v['exit_code'] == 0 and v['status'] == 'pass'\n    assert all(r['equals_reference'] for r in v['runs'])\n    return {\n        'depth': v['depth'], 'median_tokens_per_second': statistics.median(speeds),\n        'min_tokens_per_second': min(speeds), 'max_tokens_per_second': max(speeds),\n        'all_reference_ids_match': True,\n        'median_after_request_gib': {k: statistics.median(s[k] for s in snapshots) / 2**30\n            for k in ['main_cache_bytes', 'mtp_cache_bytes', 'ram_used_bytes', 'global_vram_used_bytes']},\n        'acceptance': [{'accepted': r['done']['drafts_accepted'], 'offered': r['done']['drafts_offered']} for i, r in timed],\n    }\n\ndepths = read('build-local/glm-staging-cache-final-mtp.json')\ncontrol = read('build-local/glm-staging-cache-final-control.json')\nassert depths['status'] == control['status'] == 'pass'\nassert depths['binary_sha256'] == control['binary_sha256']\nresults = [summarize(v) for v in depths['variants']]\nold = summarize(control['variants'][0])\noutput = {\n    'date': '2026-10-04', 'status': 'pass',\n    'hardware': 'Windows / Ryzen 9 9950X / 128 GiB RAM / RTX 5090 32 GiB',\n    'method': 'Fresh engine per variant; four warmup requests and five timed repeats; 39 prompt / 64 output tokens, greedy, ctx2048/batch16/threads4, IQ3_XXS. Sequential order 0,1,2,3, then old-profile control; OS file cache not cleared. Decode tokens/s = 63*1000/DONE.decode_ms, excluding startup and prefill but including draft/verify/repair. A single prompt is not a general optimum or a statistically isolated allocator test.',\n    'selected_profile': {'mtp': 0, 'reason': 'No measured speed benefit from MTP 1; user prefers avoiding draft resource cost. MTP 0 provides more main-expert cache within the same 95% global RAM/VRAM targets.', 'environment': depths['variants'][0]['configuration']['env']},\n    'results': results, 'old_profile_same_binary': old,\n    'median_gain_vs_old_profile_percent': 100 * (results[0]['median_tokens_per_second'] / old['median_tokens_per_second'] - 1),\n    'memory_note': 'Cache numbers are medians of post-request snapshots, not device allocation peaks. Freed MTP capacity goes to main cache; lower total power consumption was not measured.',\n    'binary_sha256': depths['binary_sha256'],\n    'reports': [{'source': record('build-local/glm-staging-cache-final-mtp.json'), 'report': depths}, {'source': record('build-local/glm-staging-cache-final-control.json'), 'report': control}],\n}\npath = root / 'docs/GLM53/GLM53_FLASH_STAGING_CACHE_MTP_BENCHMARK.json'\npath.write_text(json.dumps(output, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\nprint(json.dumps({k: v for k, v in output.items() if k != 'reports'}, ensure_ascii=False, indent=2))\n"
    }
  ],
