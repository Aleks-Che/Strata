  "integration_script": "import hashlib\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nroot = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(root))\nfrom serve.server import child_env\n\ncfg = json.loads((root / 'build-local/glm-ram-check-profile.json').read_text(encoding='utf-8'))\nenv = child_env(cfg)\nexe = root / 'build-local/glm5next-candidate-cuda/bin/strata-glm5next-mtp-check.exe'\ncommand = [str(exe), '--model', cfg['args'][1], '--memory-percent', '95',\n           '--reference', 'docs/GLM53/GLM53_FLASH_SYNC_REPEAT.json',\n           '--reference-logits', 'build-local/glm-sync-iq3-repeat.f32', '--baseline-only', '1',\n           '--report', 'build-local/glm-ram-logits.json']\nprint('Checking all saved F32 logits with expert-only mappings...', flush=True)\nwith (root / 'build-local/glm-ram-logits.log').open('w', encoding='utf-8') as log:\n    subprocess.run(command, cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT, check=True)\npath = root / 'build-local/glm-ram-logits.json'\nreport = json.loads(path.read_text(encoding='utf-8'))\nassert report['status'] == 'pass' and report['baseline_vs_saved_logits']['bit_exact']\nreport.update(command=command, binary_sha256=hashlib.sha256(exe.read_bytes()).hexdigest(), env=cfg['env'])\npath.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\nprint('F32 logits bit-exact; checking native pipe lifecycle...', flush=True)\nsubprocess.run([sys.executable, 'tools/check_glm5next_engine.py', '--profile',\n                'build-local/glm-ram-check-profile.json', '--reference',\n                'docs/GLM53/GLM53_FLASH_SYNC_REPEAT.json', '--output', 'build-local/glm-ram-pipe.json'],\n               cwd=root, check=True)\nprint('Native pipe checks passed.', flush=True)\n",
